---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkinGrid from '../../components/SkinGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { getSkinsByTag, searchSkins, getRandomSkins } from '../../lib/db/queries';
import { canonicalUrl } from '../../lib/seo';

const { tag: tagSlug } = Astro.params as { tag: string };
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam ?? '1', 10));
const perPage = 24;

const prettyQuery = tagSlug
  .replace(/[-_]+/g, ' ')
  .replace(/\b\w/g, (c) => c.toUpperCase());

// 1) Try exact tag match first (fast path).
const exact = await getSkinsByTag(tagSlug, currentPage, perPage);

// 2) Fuzzy search fallback when no exact tag or it has no skins.
let mode: 'tag' | 'search' | 'empty' = 'tag';
let items = exact.items;
let total = exact.total;
let matchedTags: { slug: string; name: string; type: string; count: number }[] = [];

if (!exact.tag || exact.items.length === 0) {
  const search = await searchSkins(tagSlug, currentPage, perPage);
  if (search.total > 0) {
    mode = 'search';
    items = search.items;
    total = search.total;
    matchedTags = search.matchedTags;
  } else {
    mode = 'empty';
    items = [];
    total = 0;
    matchedTags = search.matchedTags;
  }
}

const totalPages = total > 0 ? Math.max(1, Math.ceil(total / perPage)) : 1;
const tagCanonical = canonicalUrl(`/tag/${tagSlug}`);

const heading = exact.tag ? exact.tag.name : prettyQuery;
const isIndexable = mode === 'tag' && !!exact.tag;

const title =
  mode === 'empty'
    ? `No results for "${heading}" — Arctus MC`
    : `${heading} Minecraft Skins`;
const description =
  mode === 'empty'
    ? `No Minecraft skins matched "${heading}". Try a different color, style, or browse random skins on Arctus MC.`
    : `Browse ${total} Minecraft skins matching ${heading}. Find your perfect Minecraft skin.`;

const fallbackSkins = mode === 'empty' ? await getRandomSkins(18) : [];
---
<BaseLayout
  title={title}
  description={description}
  canonical={tagCanonical}
  noindex={!isIndexable}
>
  <div class="container-content py-8">

    <nav class="text-sm text-frost-500 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-frost-300 transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-frost-300 capitalize">{heading}</li>
      </ol>
    </nav>

    {(mode === 'tag' || mode === 'search') && (
      <>
        <div class="mb-8">
          <div class="flex items-center gap-3 mb-2 flex-wrap">
            <h1 class="text-2xl font-bold text-frost-100 capitalize">
              {mode === 'search' ? `Results for "${heading}"` : `${heading} Skins`}
            </h1>
            {exact.tag && <span class="tag capitalize">{exact.tag.type}</span>}
          </div>
          <p class="text-frost-500 text-sm">
            {total.toLocaleString()} {total === 1 ? 'skin' : 'skins'}
            {mode === 'tag' && (<> tagged with <strong class="text-frost-300">{heading}</strong></>)}
            {mode === 'search' && (<> matched <strong class="text-frost-300">{heading}</strong></>)}
            {totalPages > 1 && ` — page ${currentPage} of ${totalPages}`}
          </p>
        </div>

        {mode === 'search' && matchedTags.length > 0 && (
          <div class="mb-6">
            <p class="text-xs text-frost-500 uppercase tracking-wider mb-2">Related tags</p>
            <div class="flex flex-wrap gap-2">
              {matchedTags.map((t) => (
                <a href={`/tag/${t.slug}`} class="tag hover:no-underline">
                  {t.name}
                  {t.count > 0 && <span class="ml-1.5 text-frost-500 text-xs">({t.count})</span>}
                </a>
              ))}
            </div>
          </div>
        )}

        <SkinGrid skins={items} adFrequency={12} />
        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={`/tag/${tagSlug}`} />
      </>
    )}

    {mode === 'empty' && (
      <>
        <div class="card-frost p-8 mb-10 text-center">
          <h1 class="text-2xl sm:text-3xl font-bold text-frost-100 mb-2">
            No skins matched &ldquo;{heading}&rdquo;
          </h1>
          <p class="text-frost-400 text-sm sm:text-base max-w-xl mx-auto">
            We couldn&apos;t find any skins for that search. Try a color (blue, red, black),
            a style (slim, classic), or hit the button below for a random pick.
          </p>
          <div class="mt-6 flex items-center justify-center gap-3">
            <a
              href="/random"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-brand-500 hover:bg-brand-400 text-frost-950 text-sm font-semibold transition-colors"
            >
              Random skins
            </a>
            <a
              href="/"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-frost-900/60 border border-frost-700/70 text-frost-200 text-sm font-medium hover:bg-frost-800 backdrop-blur-md transition-colors"
            >
              Back home
            </a>
          </div>
        </div>

        <h2 class="section-heading">You might like these</h2>
        <SkinGrid skins={fallbackSkins} adFrequency={12} />
      </>
    )}

  </div>
</BaseLayout>
