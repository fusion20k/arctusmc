---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkinGrid from '../../components/SkinGrid.astro';
import Pagination from '../../components/Pagination.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getSkinsByTag } from '../../lib/db/queries';
import { canonicalUrl } from '../../lib/seo';

const { tag: tagSlug } = Astro.params as { tag: string };
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam ?? '1', 10));
const perPage = 24;

const { items, total, tag } = await getSkinsByTag(tagSlug, currentPage, perPage);

if (!tag) {
  return Astro.redirect('/404', 404);
}

const totalPages = Math.max(1, Math.ceil(total / perPage));
const tagCanonical = canonicalUrl(`/tag/${tagSlug}`);

const title = `${tag.name} Minecraft Skins`;
const description = `Browse ${total} Minecraft skins tagged with ${tag.name}. Explore ${tag.type === 'model' ? `${tag.name} model` : tag.name} skins and find your perfect Minecraft skin.`;
---
<BaseLayout
  title={title}
  description={description}
  canonical={tagCanonical}
>
  <div class="container-content py-8">

    <nav class="text-sm text-zinc-500 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-zinc-300 transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-zinc-300">{tag.name}</li>
      </ol>
    </nav>

    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <h1 class="text-2xl font-bold text-zinc-100">{tag.name} Skins</h1>
        <span class="tag capitalize">{tag.type}</span>
      </div>
      <p class="text-zinc-500 text-sm">
        {total.toLocaleString()} {total === 1 ? 'skin' : 'skins'} tagged with <strong class="text-zinc-400">{tag.name}</strong>
        {totalPages > 1 && ` — page ${currentPage} of ${totalPages}`}
      </p>
    </div>

    <div class="mb-6">
      <AdSlot adSlot="tag-top" format="horizontal" label="Top Banner Advertisement" />
    </div>

    {items.length > 0 ? (
      <>
        <SkinGrid skins={items} adFrequency={12} />
        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={`/tag/${tagSlug}`} />
      </>
    ) : (
      <div class="flex flex-col items-center justify-center py-20 text-zinc-500">
        <p class="text-base font-medium">No skins found for this tag.</p>
        <a href="/" class="mt-4 text-sm text-brand-400 hover:text-brand-300 transition-colors">Browse all skins →</a>
      </div>
    )}

    <div class="mt-8">
      <AdSlot adSlot="tag-bottom" format="rectangle" label="Bottom Advertisement" />
    </div>

  </div>
</BaseLayout>
