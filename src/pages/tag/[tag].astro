---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkinGrid from '../../components/SkinGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { getSkinsByTag, getRandomSkins } from '../../lib/db/queries';
import { canonicalUrl } from '../../lib/seo';

const { tag: tagSlug } = Astro.params as { tag: string };
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam ?? '1', 10));
const perPage = 24;

const { items, total, tag } = await getSkinsByTag(tagSlug, currentPage, perPage);

const prettyQuery = tagSlug
  .replace(/[-_]+/g, ' ')
  .replace(/\b\w/g, (c) => c.toUpperCase());

const hasResults = !!tag && items.length > 0;
const totalPages = hasResults ? Math.max(1, Math.ceil(total / perPage)) : 1;
const tagCanonical = canonicalUrl(`/tag/${tagSlug}`);

const heading = tag ? tag.name : prettyQuery;
const title = hasResults
  ? `${heading} Minecraft Skins`
  : `No results for "${heading}" — Arctus MC`;
const description = hasResults
  ? `Browse ${total} Minecraft skins tagged with ${heading}. Find your perfect Minecraft skin.`
  : `No Minecraft skins matched "${heading}". Try a different color, style, or browse random skins on Arctus MC.`;

const fallbackSkins = hasResults ? [] : await getRandomSkins(18);
---
<BaseLayout
  title={title}
  description={description}
  canonical={tagCanonical}
  noindex={!hasResults}
>
  <div class="container-content py-8">

    <nav class="text-sm text-frost-500 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5">
        <li><a href="/" class="hover:text-frost-300 transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-frost-300 capitalize">{heading}</li>
      </ol>
    </nav>

    {hasResults ? (
      <>
        <div class="mb-8">
          <div class="flex items-center gap-3 mb-2">
            <h1 class="text-2xl font-bold text-frost-100">{heading} Skins</h1>
            <span class="tag capitalize">{tag!.type}</span>
          </div>
          <p class="text-frost-500 text-sm">
            {total.toLocaleString()} {total === 1 ? 'skin' : 'skins'} tagged with <strong class="text-frost-300">{heading}</strong>
            {totalPages > 1 && ` — page ${currentPage} of ${totalPages}`}
          </p>
        </div>

        <SkinGrid skins={items} adFrequency={12} />
        <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl={`/tag/${tagSlug}`} />
      </>
    ) : (
      <>
        <div class="card-frost p-8 mb-10 text-center">
          <h1 class="text-2xl sm:text-3xl font-bold text-frost-100 mb-2">
            No skins matched &ldquo;{heading}&rdquo;
          </h1>
          <p class="text-frost-400 text-sm sm:text-base max-w-xl mx-auto">
            We couldn&apos;t find any skins for that search. Try a color (blue, red, black),
            a style (slim, classic), or hit the button below for a random pick.
          </p>
          <div class="mt-6 flex items-center justify-center gap-3">
            <a
              href="/random"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-brand-500 hover:bg-brand-400 text-frost-950 text-sm font-semibold transition-colors"
            >
              Random skins
            </a>
            <a
              href="/"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-frost-900/60 border border-frost-700/70 text-frost-200 text-sm font-medium hover:bg-frost-800 backdrop-blur-md transition-colors"
            >
              Back home
            </a>
          </div>
        </div>

        <h2 class="section-heading">You might like these</h2>
        <SkinGrid skins={fallbackSkins} adFrequency={12} />
      </>
    )}

  </div>
</BaseLayout>
