---
import type { SkinCardData } from '../lib/db/queries';
import SkinCard from './SkinCard.astro';
import AdSlot from './AdSlot.astro';

interface Props {
  skins: SkinCardData[];
  adFrequency?: number;
}

const { skins, adFrequency = 12 } = Astro.props;
---
{skins.length > 0 ? (
  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 sm:gap-4">
    {skins.map((skin, i) => (
      <>
        {i > 0 && i % adFrequency === 0 && (
          <div class="col-span-full">
            <AdSlot adSlot="grid-inline" format="horizontal" label="Advertisement" />
          </div>
        )}
        <SkinCard skin={skin} />
      </>
    ))}
  </div>
) : (
  <div class="flex flex-col items-center justify-center py-20 text-frost-500">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="40"
      height="40"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="mb-4 opacity-40"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10" />
      <path d="M8 15h8M9 9h.01M15 9h.01" />
    </svg>
    <p class="text-base font-medium">No skins found</p>
  </div>
)}
