---
interface Props {
  adSlot: string;
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
  class?: string;
  label?: string;
}

const {
  adSlot,
  format = 'auto',
  class: className = '',
  label = 'Advertisement',
} = Astro.props;

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---
<div class:list={['w-full overflow-hidden', className]}>
  {adsenseClient ? (
    <>
      <ins
        class="adsbygoogle block"
        data-ad-client={adsenseClient}
        data-ad-slot={adSlot}
        data-ad-format={format}
        data-full-width-responsive="true"
      ></ins>
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </>
  ) : (
    <div class="ad-placeholder">
      <span>{label}</span>
    </div>
  )}
</div>
